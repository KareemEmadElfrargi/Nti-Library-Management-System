<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
                  version="3.2">
    <entity class="org.example.demo.entity.Author">
        <attributes>
            <one-to-many name="books" mapped-by="author" fetch="LAZY" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="org.example.demo.entity.Book">
        <attributes>
            <many-to-one name="author" fetch="LAZY">
                <join-column name="author_id"/>
            </many-to-one>
        </attributes>
    </entity>

</entity-mappings>
